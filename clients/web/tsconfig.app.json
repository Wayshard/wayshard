{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@wayshard/gui/session-ui/*": [
        "../gui/src/session-ui/*"
      ],
      "@wayshard/gui/*": [
        "../gui/src/*"
      ],
      "@wayshard/gui": [
        "../gui/src/index.tsx"
      ]
    },
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "src/wayshard/main.tsx"
  ]
}